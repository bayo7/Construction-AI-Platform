<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Construction AI</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Akıllı İnşaat ve Gayrimenkul Platformu")" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- AOS Animasyon -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #1a3c5e;
            --primary-light: #2d6a9f;
            --accent: #f0a500;
            --accent-dark: #d4920a;
            --text-dark: #1a1a2e;
            --text-muted: #6c757d;
            --bg-light: #f8f9fc;
            --border: #e8ecf0;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background: var(--white);
            line-height: 1.7;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
        }

        /* ── Navbar ── */
        .navbar-main {
            background: rgba(26, 60, 94, 0.97);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            transition: all 0.3s;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

            .navbar-main.scrolled {
                padding: 0.6rem 0;
                box-shadow: 0 2px 20px rgba(0,0,0,0.15);
            }

        .navbar-brand-logo {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--white) !important;
            letter-spacing: -0.5px;
        }

            .navbar-brand-logo span {
                color: var(--accent);
            }

        .navbar-main .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 1rem !important;
            transition: color 0.2s;
        }

            .navbar-main .nav-link:hover,
            .navbar-main .nav-link.active {
                color: var(--accent) !important;
            }

        .btn-nav-cta {
            background: var(--accent);
            color: var(--white) !important;
            border-radius: 50px;
            padding: 0.45rem 1.4rem !important;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-nav-cta:hover {
                background: var(--accent-dark);
                transform: translateY(-1px);
            }

        /* ── Section Başlıkları ── */
        .section-badge {
            display: inline-block;
            background: rgba(240,165,0,0.12);
            color: var(--accent-dark);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.3rem 1rem;
            border-radius: 50px;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .section-subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            max-width: 560px;
            margin: 0 auto;
        }

        /* ── Proje Kartları ── */
        .project-card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            background: var(--white);
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }

            .project-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 40px rgba(26,60,94,0.15);
            }

            .project-card .card-img-wrapper {
                position: relative;
                overflow: hidden;
                height: 220px;
            }

                .project-card .card-img-wrapper img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.4s;
                }

            .project-card:hover .card-img-wrapper img {
                transform: scale(1.05);
            }

            .project-card .card-overlay {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                background: linear-gradient(to top, rgba(26,60,94,0.85), transparent);
                padding: 1.5rem 1rem 0.75rem;
            }

        .project-status-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: var(--accent);
            color: var(--white);
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
        }

        .project-card .card-body {
            padding: 1.25rem;
        }

        .project-price {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
        }

        .project-location {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        /* ── Progress Bar ── */
        .progress-thin {
            height: 5px;
            border-radius: 10px;
            background: var(--border);
        }

            .progress-thin .progress-bar {
                background: var(--accent);
                border-radius: 10px;
            }

        /* ── Footer ── */
        footer {
            background: var(--primary);
            color: rgba(255,255,255,0.75);
        }

            footer h6 {
                color: var(--white);
                font-family: 'Inter', sans-serif;
                font-weight: 700;
            }

            footer a {
                color: rgba(255,255,255,0.65);
                text-decoration: none;
                transition: color 0.2s;
            }

                footer a:hover {
                    color: var(--accent);
                }

        .footer-bottom {
            background: rgba(0,0,0,0.2);
            font-size: 0.85rem;
        }

        /* ── Butonlar ── */
        .btn-primary-custom {
            background: var(--primary);
            color: var(--white);
            border: none;
            border-radius: 50px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary-custom:hover {
                background: var(--primary-light);
                color: var(--white);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(26,60,94,0.3);
            }

        .btn-accent {
            background: var(--accent);
            color: var(--white);
            border: none;
            border-radius: 50px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-accent:hover {
                background: var(--accent-dark);
                color: var(--white);
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(240,165,0,0.4);
            }

        /* ── Testimonial ── */
        .testimonial-card {
            background: var(--white);
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
            border-left: 4px solid var(--accent);
        }

        .stars {
            color: var(--accent);
            font-size: 0.9rem;
        }

        /* ── Back to Top ── */
        #backToTop {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 44px;
            height: 44px;
            background: var(--primary);
            color: var(--white);
            border: none;
            border-radius: 50%;
            font-size: 1.2rem;
            display: none;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 999;
            transition: all 0.3s;
            box-shadow: 0 4px 16px rgba(26,60,94,0.3);
        }

            #backToTop:hover {
                background: var(--accent);
                transform: translateY(-3px);
            }

            #backToTop.visible {
                display: flex;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ════ NAVBAR ════ -->
    <nav class="navbar-main navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand-logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-buildings-fill me-2"></i>CONSTRUCTION<span>AI</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <i class="bi bi-list text-white fs-4"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav mx-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Projects" ? "active" : "")"
                           asp-controller="Home" asp-action="Projects">Projeler</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                           asp-controller="Home" asp-action="Contact">İletişim</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <a asp-area="Admin" asp-controller="Auth" asp-action="Login" class="btn-nav-cta nav-link">
                        <i class="bi bi-grid me-1"></i>Admin
                    </a>
                </div>
            </div>
        </div>
    </nav>
    <!-- ════ /NAVBAR ════ -->
    <!-- ════ SAYFA İÇERİĞİ ════ -->
    @RenderBody()
    <!-- ════ /SAYFA İÇERİĞİ ════ -->
    <!-- ════ FOOTER ════ -->
    <footer class="pt-5 pb-0 mt-5">
        <div class="container">
            <div class="row g-4 pb-4">
                <!-- Marka -->
                <div class="col-lg-4">
                    <h5 class="text-white mb-3">
                        <i class="bi bi-buildings-fill me-2" style="color:var(--accent)"></i>CONSTRUCTION<span style="color:var(--accent)">AI</span>
                    </h5>
                    <p class="small mb-3">
                        Yapay zeka destekli akıllı arama motoruyla, aradığınız evi değil, hayalinizdeki yaşamı bulun.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="fs-5"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="fs-5"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="fs-5"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <!-- Hızlı Linkler -->
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Hızlı Linkler</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-action="Index">Ana Sayfa</a></li>
                        <li class="mb-2"><a asp-action="Projects">Projeler</a></li>
                        <li class="mb-2"><a asp-action="Contact">İletişim</a></li>
                        <li class="mb-2"><a asp-area="Admin" asp-controller="Auth" asp-action="Login">Admin</a></li>
                    </ul>
                </div>

                <!-- İletişim -->
                <div class="col-lg-3">
                    <h6 class="mb-3">İletişim</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2" style="color:var(--accent)"></i>İstanbul, Türkiye</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2" style="color:var(--accent)"></i>+90 (212) 000 00 00</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2" style="color:var(--accent)"></i>info@constructionai.com</li>
                    </ul>
                </div>

                <!-- Çalışma Saatleri -->
                <div class="col-lg-3">
                    <h6 class="mb-3">Çalışma Saatleri</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2 d-flex justify-content-between">
                            <span>Pazartesi – Cuma</span><span class="text-white">09:00–18:00</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span>Cumartesi</span><span class="text-white">10:00–15:00</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-between">
                            <span>Pazar</span><span style="color:var(--accent)">Kapalı</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-bottom py-3">
            <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year Construction AI Platform. Tüm hakları saklıdır.</span>
                <span>Powered by <span style="color:var(--accent)">Gemini AI</span> embeddings</span>
            </div>
        </div>
    </footer>
    <!-- ════ /FOOTER ════ -->
    <!-- Back to Top -->
    <button id="backToTop" title="Yukarı Çık"><i class="bi bi-chevron-up"></i></button>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 700, once: true, offset: 60 });

        // Navbar scroll efekti
        window.addEventListener('scroll', () => {
            document.querySelector('.navbar-main').classList.toggle('scrolled', window.scrollY > 50);
            document.getElementById('backToTop').classList.toggle('visible', window.scrollY > 300);
        });

        // Back to top
        document.getElementById('backToTop').addEventListener('click', () =>
            window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
