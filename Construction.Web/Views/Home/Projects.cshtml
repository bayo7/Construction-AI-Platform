@model Construction.Web.Models.ProjectsViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Projeler";
}

<!-- Page Header -->
<section style="background:linear-gradient(135deg,#1a3c5e,#2d6a9f);padding:4rem 0 5rem;">
    <div class="container text-center">
        <h1 style="color:#fff;margin-bottom:0.5rem;">Tüm Projeler</h1>
        <p style="color:rgba(255,255,255,0.75);">
            @Model.TotalCount proje arasından size en uygun olanı seçin
        </p>
    </div>
    <svg viewBox="0 0 1440 50" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block;margin-top:-1px;">
        <path d="M0,25 C480,50 960,0 1440,25 L1440,50 L0,50 Z" fill="#ffffff" />
    </svg>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <!-- ── Sol: Filtreler ── -->
            <div class="col-lg-3">
                <div style="background:#fff;border-radius:16px;padding:1.5rem;box-shadow:0 2px 12px rgba(0,0,0,0.07);position:sticky;top:80px;">
                    <h6 class="fw-bold mb-3" style="color:var(--primary);font-family:'Inter',sans-serif;">
                        <i class="bi bi-funnel me-2"></i>Filtreler
                    </h6>

                    <!-- Metin Arama -->
                    <form asp-action="Projects" method="get" id="filterForm">
                        <input type="hidden" name="categoryId" id="hiddenCategoryId" value="@Model.SelectedCategory" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Arama</label>
                            <div class="input-group">
                                <input type="text" name="search" class="form-control form-control-sm"
                                       value="@Model.SearchQuery" placeholder="Proje adı, konum..." />
                                <button class="btn btn-sm" type="submit"
                                        style="background:var(--primary);color:#fff;">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Kategori -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Kategori</label>
                            <div class="d-flex flex-column gap-2">
                                <a asp-action="Projects" asp-route-search="@Model.SearchQuery"
                                   class="category-filter-btn @(Model.SelectedCategory == null ? "active" : "")"
                                   style="padding:0.4rem 0.8rem;border-radius:8px;font-size:0.85rem;text-decoration:none;background:@(Model.SelectedCategory == null ? "var(--primary)" : "var(--bg-light)");color:@(Model.SelectedCategory == null ? "#fff" : "var(--text-dark)");">
                                    <i class="bi bi-grid me-1"></i>Tümü
                                </a>
                                @foreach (var cat in Model.Categories)
                                {
                                    <a asp-action="Projects"
                                       asp-route-categoryId="@cat.Id"
                                       asp-route-search="@Model.SearchQuery"
                                       class="category-filter-btn @(Model.SelectedCategory == cat.Id ? "active" : "")"
                                       style="padding:0.4rem 0.8rem;border-radius:8px;font-size:0.85rem;text-decoration:none;background:@(Model.SelectedCategory == cat.Id ? "var(--primary)" : "var(--bg-light)");color:@(Model.SelectedCategory == cat.Id ? "#fff" : "var(--text-dark)");">
                                        <i class="bi bi-building me-1"></i>@cat.CategoryName
                                    </a>
                                }
                            </div>
                        </div>
                    </form>

                    @if (Model.SelectedCategory.HasValue || !string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a asp-action="Projects" class="btn btn-sm btn-outline-danger w-100 mt-2">
                            <i class="bi bi-x me-1"></i>Filtreleri Temizle
                        </a>
                    }
                </div>
            </div>

            <!-- ── Sağ: Proje Listesi ── -->
            <div class="col-lg-9">

                <!-- Sonuç Bilgisi -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p class="text-muted mb-0 small">
                        <strong style="color:var(--primary);">@Model.TotalCount</strong> proje bulundu
                        @if (!string.IsNullOrEmpty(Model.SearchQuery))
                        {
                            <span> — "<strong>@Model.SearchQuery</strong>" için</span>
                        }
                    </p>
                </div>

                @if (!Model.Projects.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search fs-1 text-muted"></i>
                        <h5 class="mt-3 text-muted">Proje bulunamadı</h5>
                        <p class="text-muted">Filtreleri değiştirmeyi deneyin.</p>
                        <a asp-action="Projects" class="btn-primary-custom btn mt-2">Tümünü Göster</a>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var project in Model.Projects)
                        {
                            <div class="col-md-6 col-xl-4" data-aos="fade-up">
                                <div class="project-card card h-100">
                                    <div class="card-img-wrapper">
                                        @if (!string.IsNullOrEmpty(project.CoverImageUrl) && project.CoverImageUrl != "no-image.jpg")
                                        {
                                            <img src="/images/@project.CoverImageUrl" alt="@project.Title" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div style="width:100%;height:100%;background:linear-gradient(135deg,#1a3c5e,#2d6a9f);display:flex;align-items:center;justify-content:center;">
                                                <i class="bi bi-building" style="font-size:3rem;color:rgba(255,255,255,0.3);"></i>
                                            </div>
                                        }
                                        <span class="project-status-badge">@project.ProjectStatus</span>
                                        <div class="card-overlay">
                                            <span style="color:rgba(255,255,255,0.85);font-size:0.8rem;">
                                                <i class="bi bi-tag me-1"></i>@project.Category?.CategoryName
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h6 class="fw-bold mb-1" style="color:var(--primary);font-family:'Inter',sans-serif;">@project.Title</h6>
                                        <p class="project-location mb-2"><i class="bi bi-geo-alt me-1"></i>@project.Location</p>
                                        <p class="text-muted small mb-3" style="flex:1;">
                                            @(project.Description?.Length > 80 ? project.Description[..80] + "..." : project.Description)
                                        </p>
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small class="text-muted">Tamamlanma</small>
                                                <small class="fw-semibold">%@project.CompleetionRate</small>
                                            </div>
                                            <div class="progress-thin">
                                                <div class="progress-bar" style="width:@project.CompleetionRate%;"></div>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="project-price">@project.MinPrice.ToString("N0") ₺</span>
                                            <a asp-action="ProjectDetail" asp-route-id="@project.Id"
                                               class="btn btn-sm" style="background:var(--primary);color:#fff;border-radius:50px;padding:0.35rem 1rem;font-size:0.82rem;">
                                                İncele <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-5 d-flex justify-content-center">
                            <ul class="pagination gap-1">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Projects"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           asp-route-categoryId="@Model.SelectedCategory"
                                           asp-route-search="@Model.SearchQuery"
                                           style="border-radius:8px;border:none;background:var(--bg-light);">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Projects"
                                           asp-route-page="@i"
                                           asp-route-categoryId="@Model.SelectedCategory"
                                           asp-route-search="@Model.SearchQuery"
                                           style="border-radius:8px;border:none;@(i == Model.CurrentPage ? "background:var(--primary);color:#fff;" : "background:var(--bg-light);color:var(--text-dark);" )">
                                            @i
                                        </a>
                                    </li>
                                }
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-action="Projects"
                                           asp-route-page="@(Model.CurrentPage + 1)"
                                           asp-route-categoryId="@Model.SelectedCategory"
                                           asp-route-search="@Model.SearchQuery"
                                           style="border-radius:8px;border:none;background:var(--bg-light);">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</section>
