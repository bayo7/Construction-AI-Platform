@model Construction.Entity.Entities.Project
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Yeni Proje";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-xl">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Yeni Proje Girişi</h5>
                <a href="/Admin/Project/Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bx bx-arrow-back me-1"></i>Listeye Dön
                </a>
            </div>
            <div class="card-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="text-danger mb-3 border p-3 rounded"></div>
                }

                <form method="post" action="/Admin/Project/CreateProject" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Proje Başlığı</label>
                            <input type="text" class="form-control" asp-for="Title"
                                   placeholder="Örn: Vadi İstanbul Konutları" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Kategori</label>
                            @Html.DropDownListFor(x => x.CategoryId, (List<SelectListItem>)ViewBag.v,
                            "--- Kategori Seçiniz ---", new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Lokasyon</label>
                            <input type="text" class="form-control" asp-for="Location"
                                   placeholder="Örn: Sarıyer, İstanbul" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Başlangıç Fiyatı (₺)</label>
                            <input type="number" class="form-control" asp-for="MinPrice" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Proje Durumu</label>
                            <input type="text" class="form-control" asp-for="ProjectStatus"
                                   placeholder="Örn: Satışta, Yapım Aşamasında" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Tamamlanma Oranı: <span id="rangeValue">50</span>%
                        </label>
                        <input type="range" class="form-range" asp-for="CompleetionRate"
                               min="0" max="100" id="customRange1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Proje Açıklaması</label>
                        <textarea class="form-control" asp-for="Description" rows="4"
                                  placeholder="Proje hakkında detaylı bilgi..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- ── KAPAK GÖRSELİ ── -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kapak Görseli</label>
                        <input type="file" class="form-control" name="imageFile"
                               accept="image/jpeg,image/png,image/webp"
                               id="coverInput" />
                        <small class="text-muted">JPG, PNG veya WEBP. Önerilen: 1200×800px</small>
                        <div id="coverPreview" class="mt-2"></div>
                    </div>

                    <!-- ── GALERİ GÖRSELLERİ ── -->
                    <div class="card border-0 bg-light mb-4">
                        <div class="card-header bg-transparent border-0">
                            <h6 class="mb-0"><i class="bx bx-images me-1 text-primary"></i>Galeri Görselleri</h6>
                            <small class="text-muted">Opsiyonel — Proje kaydedildikten sonra da eklenebilir.</small>
                        </div>
                        <div class="card-body">
                            <input type="file" class="form-control" name="galleryFiles"
                                   multiple accept="image/jpeg,image/png,image/webp"
                                   id="galleryInput" />
                            <small class="text-muted">Birden fazla dosya seçebilirsiniz (Ctrl+Tıkla)</small>
                            <div id="galleryPreview" class="row g-2 mt-2"></div>
                        </div>
                    </div>

                    <!-- Aktif/Pasif -->
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive"
                               id="isActiveSwitch" checked />
                        <label class="form-check-label text-success fw-semibold"
                               for="isActiveSwitch" id="isActiveLabel">
                            Proje Yayında (Aktif)
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i>Kaydet
                        </button>
                        <a href="/Admin/Project/Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ─── Range ─────────────────────────────────────────────────────────────────
        document.getElementById('customRange1').addEventListener('input', e =>
            document.getElementById('rangeValue').innerText = e.target.value);

        // ─── IsActive label ────────────────────────────────────────────────────────
        const sw = document.getElementById('isActiveSwitch');
        const lb = document.getElementById('isActiveLabel');
        function syncLabel() {
            lb.textContent = sw.checked ? 'Proje Yayında (Aktif)' : 'Proje Yayında Değil (Pasif)';
            lb.className   = sw.checked ? 'form-check-label text-success fw-semibold'
                                        : 'form-check-label text-danger fw-semibold';
        }
        sw.addEventListener('change', syncLabel);
        syncLabel();

        // ─── Kapak önizleme ────────────────────────────────────────────────────────
        document.getElementById('coverInput').addEventListener('change', function() {
            const preview = document.getElementById('coverPreview');
            preview.innerHTML = '';
            if (this.files[0]) {
                const reader = new FileReader();
                reader.onload = e =>
                    preview.innerHTML = `<img src="${e.target.result}"
                        style="height:120px;width:180px;object-fit:cover;border-radius:8px;border:2px solid #696cff;" />`;
                reader.readAsDataURL(this.files[0]);
            }
        });

        // ─── Galeri önizleme ────────────────────────────────────────────────────────
        document.getElementById('galleryInput').addEventListener('change', function() {
            const preview = document.getElementById('galleryPreview');
            preview.innerHTML = '';
            Array.from(this.files).slice(0, 10).forEach(file => {
                const reader = new FileReader();
                reader.onload = e =>
                    preview.innerHTML += `
                    <div class="col-6 col-md-3 col-lg-2">
                        <img src="${e.target.result}"
                             style="width:100%;height:90px;object-fit:cover;border-radius:8px;border:2px dashed #696cff;" />
                    </div>`;
                reader.readAsDataURL(file);
            });
        });
    </script>
}
