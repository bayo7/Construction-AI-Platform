@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "AI Öneri Motoru";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Başlık -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar avatar-sm flex-shrink-0">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="bx bx-brain"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">AI Öneri Motoru</h5>
                            <small class="text-muted">Semantic Search — Voyage AI Embeddings</small>
                        </div>
                    </div>
                    <button class="btn btn-outline-warning btn-sm" id="btnRegenerateAll">
                        <i class="bx bx-refresh me-1"></i> Tüm Embedding'leri Yenile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Arama Kutusu -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bx bx-search me-2"></i>Anlamsal Arama Testi</h6>
                    <small class="text-muted">Kullanıcının yazacağı gibi doğal dilde arama yapın</small>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Arama Sorgusu</label>
                            <input type="text"
                                   id="searchQuery"
                                   class="form-control form-control-lg"
                                   placeholder="Örn: doğayla iç içe huzurlu bir ev, deniz manzaralı lüks daire, bütçeye uygun şehir merkezi..."
                                   autofocus />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Sonuç Sayısı</label>
                            <select id="topN" class="form-select form-select-lg">
                                <option value="3">Top 3</option>
                                <option value="5" selected>Top 5</option>
                                <option value="10">Top 10</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary btn-lg w-100" id="btnSearch">
                                <i class="bx bx-search me-1"></i> Ara
                            </button>
                        </div>
                    </div>

                    <!-- Örnek sorgular -->
                    <div class="mt-3">
                        <small class="text-muted me-2">Hızlı örnek:</small>
                        <span class="badge bg-label-primary me-1 cursor-pointer example-query" style="cursor:pointer">doğayla iç içe huzurlu</span>
                        <span class="badge bg-label-success me-1 cursor-pointer example-query" style="cursor:pointer">deniz manzaralı lüks</span>
                        <span class="badge bg-label-info me-1 cursor-pointer example-query" style="cursor:pointer">çocuklu aile için güvenli</span>
                        <span class="badge bg-label-warning me-1 cursor-pointer example-query" style="cursor:pointer">merkezi konum yatırımlık</span>
                        <span class="badge bg-label-danger me-1 cursor-pointer example-query" style="cursor:pointer">uygun fiyatlı başlangıç evi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingSection" class="text-center py-4 d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">AI analiz ediyor...</p>
    </div>

    <!-- Sonuçlar -->
    <div id="resultsSection" class="d-none">
        <div class="row mb-3">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <span id="queryLabel" class="text-primary fw-bold"></span>
                    <span class="text-muted"> için AI önerileri</span>
                </h6>
                <small class="text-muted" id="resultCount"></small>
            </div>
        </div>
        <div class="row g-4" id="resultCards"></div>
    </div>

    <!-- Hata -->
    <div id="errorSection" class="d-none">
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bx bx-error-circle fs-4"></i>
            <span id="errorMessage"></span>
        </div>
    </div>

    <!-- Boş sonuç -->
    <div id="emptySection" class="d-none text-center py-5">
        <i class="bx bx-search-alt" style="font-size:3rem; color:#a8aaae;"></i>
        <h6 class="mt-3 text-muted">Eşleşen proje bulunamadı</h6>
        <p class="text-muted small">Projelerin embedding'leri oluşturulmuş olmalı. "Tüm Embedding'leri Yenile" butonunu deneyin.</p>
    </div>

</div>

@section Scripts {
    <script>
        // ─── Yardımcı: Renk sınıfı (skor'a göre) ───────────────────────────────────
        function scoreColor(score) {
            if (score >= 85) return 'success';
            if (score >= 70) return 'primary';
            if (score >= 55) return 'warning';
            return 'secondary';
        }

        function scoreLabel(score) {
            if (score >= 85) return 'Çok Yüksek';
            if (score >= 70) return 'Yüksek';
            if (score >= 55) return 'Orta';
            return 'Düşük';
        }

        // ─── Sonuç kartı oluştur ────────────────────────────────────────────────────
        function buildCard(item) {
            const color = scoreColor(item.similarityScore);
            const label = scoreLabel(item.similarityScore);
            const imgSrc = item.coverImageUrl && item.coverImageUrl !== 'no-image.jpg'
                ? `/images/${item.coverImageUrl}`
                : `/Admin/sneat-bootstrap-html-admin-template-free/assets/img/avatars/1.png`;

            return `
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="position-relative">
                        <img src="${imgSrc}" class="card-img-top" style="height:180px;object-fit:cover;" onerror="this.src='/Admin/sneat-bootstrap-html-admin-template-free/assets/img/avatars/1.png'" />
                        <span class="badge bg-${color} position-absolute top-0 end-0 m-2" style="font-size:0.8rem;">
                            %${item.similarityScore} · ${label}
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0 fw-bold">${item.title}</h6>
                            <span class="badge bg-label-info ms-2">${item.category ?? '-'}</span>
                        </div>
                        <p class="text-muted small mb-2">
                            <i class="bx bx-map-pin me-1"></i>${item.location}
                        </p>
                        <div class="progress mb-2" style="height:6px;" title="Eşleşme skoru">
                            <div class="progress-bar bg-${color}" style="width:${item.similarityScore}%"></div>
                        </div>
                        <p class="small text-muted mb-3">
                            <i class="bx bx-info-circle me-1 text-${color}"></i>${item.matchReason}
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">${Number(item.minPrice).toLocaleString('tr-TR')} ₺</span>
                            <a href="/Admin/Project/UpdateProject/${item.id}" class="btn btn-sm btn-outline-primary">
                                <i class="bx bx-edit-alt me-1"></i>Düzenle
                            </a>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        // ─── Arama ──────────────────────────────────────────────────────────────────
        async function doSearch() {
            const query = document.getElementById('searchQuery').value.trim();
            const topN  = parseInt(document.getElementById('topN').value);

            if (!query) {
                document.getElementById('searchQuery').focus();
                return;
            }

            // UI sıfırla
            ['resultsSection','errorSection','emptySection'].forEach(id =>
                document.getElementById(id).classList.add('d-none'));
            document.getElementById('loadingSection').classList.remove('d-none');

            try {
                const res = await fetch('/Admin/AI/Search', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query, topN })
                });

                const data = await res.json();
                document.getElementById('loadingSection').classList.add('d-none');

                if (!res.ok || !data.success) {
                    document.getElementById('errorMessage').textContent = data.error ?? 'Bilinmeyen hata.';
                    document.getElementById('errorSection').classList.remove('d-none');
                    return;
                }

                if (!data.results || data.results.length === 0) {
                    document.getElementById('emptySection').classList.remove('d-none');
                    return;
                }

                document.getElementById('queryLabel').textContent = `"${query}"`;
                document.getElementById('resultCount').textContent = `${data.results.length} proje bulundu`;
                document.getElementById('resultCards').innerHTML = data.results.map(buildCard).join('');
                document.getElementById('resultsSection').classList.remove('d-none');

            } catch (err) {
                document.getElementById('loadingSection').classList.add('d-none');
                document.getElementById('errorMessage').textContent = `İstek hatası: ${err.message}`;
                document.getElementById('errorSection').classList.remove('d-none');
            }
        }

        // ─── Toplu Embedding Yenileme ────────────────────────────────────────────────
        document.getElementById('btnRegenerateAll').addEventListener('click', async () => {
            if (!confirm('Tüm projelerin embedding\'leri yenilenecek. Bu işlem biraz sürebilir. Devam edilsin mi?'))
                return;

            const btn = document.getElementById('btnRegenerateAll');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>İşleniyor...';

            try {
                const res  = await fetch('/Admin/AI/RegenerateAll', { method: 'POST' });
                const data = await res.json();
                alert(data.message ?? data.error ?? 'İşlem tamamlandı.');
            } catch (e) {
                alert('Hata: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-refresh me-1"></i> Tüm Embedding\'leri Yenile';
            }
        });

        // ─── Event Listener'lar ──────────────────────────────────────────────────────
        document.getElementById('btnSearch').addEventListener('click', doSearch);

        document.getElementById('searchQuery').addEventListener('keydown', e => {
            if (e.key === 'Enter') doSearch();
        });

        document.querySelectorAll('.example-query').forEach(badge => {
            badge.addEventListener('click', () => {
                document.getElementById('searchQuery').value = badge.textContent;
                doSearch();
            });
        });
    </script>
}
