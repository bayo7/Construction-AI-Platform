<!doctype html>
<html lang="tr"
      class="layout-menu-fixed layout-compact"
      data-assets-path="/Admin/sneat-bootstrap-html-admin-template-free/assets/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>Construction AI - Admin Panel</title>
    <meta name="description" content="İnşaat ve Gayrimenkul Yönetim Sistemi" />
    <link rel="icon" type="image/x-icon" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/img/favicon/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/fonts/iconify-icons.css" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/css/core.css" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/css/demo.css" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/apex-charts/apex-charts.css" />
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/js/helpers.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/js/config.js"></script>
</head>
<body>

    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- ════ SIDEBAR MENÜ ════ -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a href="/Admin/Dashboard" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <i class="bx bx-buildings fs-3 text-primary"></i>
                        </span>
                        <span class="app-brand-text demo menu-text fw-bolder ms-2">InsaatAdmin</span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
                        <i class="bx bx-chevron-left bx-sm align-middle"></i>
                    </a>
                </div>

                <!-- Rol rozeti -->
                <div class="px-3 pb-2 pt-0">
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-label-danger w-100 py-1">
                            <i class="bx bx-shield me-1"></i>Yönetici
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-label-warning w-100 py-1">
                            <i class="bx bx-edit me-1"></i>Editör
                        </span>
                    }
                </div>

                <div class="menu-inner-shadow"></div>
                <ul class="menu-inner py-1">

                    <!-- Dashboard — herkese açık -->
                    <li class="menu-item">
                        <a href="/Admin/Dashboard" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-circle"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>

                    <li class="menu-header small text-uppercase">
                        <span class="menu-header-text">İçerik Yönetimi</span>
                    </li>

                    <!-- Kategoriler — Admin + Editor -->
                    <li class="menu-item">
                        <a href="/Admin/Category/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-category"></i>
                            <div>Kategoriler</div>
                        </a>
                    </li>

                    <!-- Projeler — Admin + Editor -->
                    <li class="menu-item">
                        <a href="/Admin/Project/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-building-house"></i>
                            <div>Projeler</div>
                        </a>
                    </li>

                    <!-- AI — Admin + Editor -->
                    <li class="menu-item">
                        <a href="/Admin/AI/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-brain"></i>
                            <div>AI Öneri Motoru</div>
                        </a>
                    </li>

                    <!-- Yorumlar — Admin + Editor -->
                    <li class="menu-item">
                        <a href="/Admin/Testimonial/Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-comment-detail"></i>
                            <div>Müşteri Yorumları</div>
                        </a>
                    </li>

                    <!-- Site Ayarları — SADECE ADMIN -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="menu-header small text-uppercase">
                            <span class="menu-header-text">Site Ayarları</span>
                        </li>
                        <li class="menu-item">
                            <a href="/Admin/User/Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-user"></i>
                                <div>Kullanıcılar</div>
                            </a>
                        </li>
                        <li class="menu-item">
                            <a href="/Admin/Role/Index" class="menu-link">
                                <i class="menu-icon tf-icons bx bx-lock-open-alt"></i>
                                <div>Roller</div>
                            </a>
                        </li>
                    }

                </ul>
            </aside>
            <!-- ════ /SIDEBAR MENÜ ════ -->

            <div class="layout-page">

                <!-- ════ NAVBAR ════ -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>
                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <div class="navbar-nav align-items-center me-auto">
                            <div class="nav-item d-flex align-items-center">
                                <span class="w-px-22 h-px-22"><i class="icon-base bx bx-search icon-md"></i></span>
                                <input type="text" class="form-control border-0 shadow-none ps-1 ps-sm-2 d-md-block d-none"
                                       placeholder="Ara..." aria-label="Search..." />
                            </div>
                        </div>
                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                            <!-- Kullanıcı Dropdown -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="/Admin/sneat-bootstrap-html-admin-template-free/assets/img/avatars/1.png"
                                             alt="avatar" class="w-px-40 h-auto rounded-circle" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <img src="/Admin/sneat-bootstrap-html-admin-template-free/assets/img/avatars/1.png"
                                                             alt="avatar" class="w-px-40 h-auto rounded-circle" />
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <span class="fw-semibold d-block">@User.Identity?.Name</span>
                                                    <small class="text-muted">
                                                        @if (User.IsInRole("Admin"))
                                                        {
                                                            <text>Yönetici</text>
                                                        }
                                                        else
                                                        {

                                                            <text>Editör</text>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li><div class="dropdown-divider"></div></li>
                                    <li>
                                        <form asp-action="Logout" asp-controller="Auth" asp-area="Admin"
                                              method="post" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="dropdown-item text-danger w-100 text-start"
                                                    style="background:none;border:none;">
                                                <i class="bx bx-power-off me-2"></i>Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- ════ /NAVBAR ════ -->
                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl">
                            <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                                <div class="mb-2 mb-md-0">
                                    &copy; <script>document.write(new Date().getFullYear());</script>
                                    Construction AI Platform. Tüm hakları saklıdır.
                                </div>
                            </div>
                        </div>
                    </footer>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/popper/popper.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/js/bootstrap.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/js/menu.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/js/main.js"></script>
    <script src="/Admin/sneat-bootstrap-html-admin-template-free/assets/js/dashboards-analytics.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
